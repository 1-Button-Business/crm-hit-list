  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "lucide-react": "1.62.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "6.0.3"
  }
}
