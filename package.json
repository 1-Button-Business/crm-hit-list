{
  "name": "crm-hit-list",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A simple CRM that runs on your own computer. Drey's gift to 1BB members.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node server/main.ts",
