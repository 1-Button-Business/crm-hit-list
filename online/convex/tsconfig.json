{
  "compilerOptions": {
    "target": "ESNext", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "isolatedModules": true, "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true, "types": ["node"]
  },
  "include": ["./**/*", "../../shared/*.ts", "../../presets/*.ts", "../../crm.config.ts"],
  "exclude": ["./_generated", "../../shared/*.test.ts"]
}
