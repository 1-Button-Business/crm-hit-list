{
  // Your CRM's web pages, served by Cloudflare. worker.ts only passes Claude's connector calls (/mcp) on to your Convex database.
  // Rename "my-crm" if you like. The address becomes https://<name>.<your-subdomain>.workers.dev until you add your own domain.
  "name": "my-crm",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // Your Convex site address (ends in .convex.site). Shown by `npx convex deploy`, or in the Convex dashboard under Settings.
  "vars": { "CONVEX_SITE": "https://YOUR-DEPLOYMENT.convex.site" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/mcp", "/mcp/*", "/.well-known/*"] }
}
